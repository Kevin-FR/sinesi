{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinesi.dev/contracts/import-report.schema.json",
  "title": "Filius data import report v1",
  "$ref": "#/$defs/report",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conversion": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "type": "string",
          "maxLength": 512
        },
        "rule": {
          "enum": [
            "known_property"
          ]
        }
      },
      "required": [
        "source",
        "target",
        "rule"
      ],
      "additionalProperties": false
    },
    "issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "source": {
          "type": "string",
          "maxLength": 4096
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "code",
        "source",
        "detail"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "bytes": {
          "$ref": "#/$defs/decimal"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "resources": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "executable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256",
        "resources",
        "executable"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "interfaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "links": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "applications": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "annotations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "resources": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "devices",
        "interfaces",
        "links",
        "applications",
        "files",
        "annotations",
        "resources"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "format_version": {
          "const": 1
        },
        "source_name": {
          "type": "string",
          "maxLength": 1024
        },
        "source_sha256": {
          "$ref": "#/$defs/sha"
        },
        "counts": {
          "$ref": "#/$defs/counts"
        },
        "converted": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/conversion"
          }
        },
        "unconverted_fields": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "unknown_classes": {
          "type": "array",
          "maxItems": 200000,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "preserved": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "execution_performed": {
          "const": false
        },
        "functional_equivalence_verified": {
          "const": false
        }
      },
      "required": [
        "format_version",
        "source_name",
        "source_sha256",
        "counts",
        "converted",
        "unconverted_fields",
        "issues",
        "unknown_classes",
        "preserved",
        "execution_performed",
        "functional_equivalence_verified"
      ],
      "additionalProperties": false
    }
  }
}
