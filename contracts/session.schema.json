    "session_view": {
      "type": "object",
      "properties": {
        "diagram": {
          "type": "boolean"
        },
        "zoom": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "pan": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -10000000,
            "maximum": 10000000
          }
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
