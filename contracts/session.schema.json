    "editing_state": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "inspector": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object"
              }
            }
          ]
        },
        "desktop": {
          "type": "object",
          "properties": {
            "host": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "drafts": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "properties": {
                  "device": {
                    "$ref": "#/$defs/id"
                  },
                  "application": {
                    "$ref": "#/$defs/id"
                  },
                  "state": {
                    "type": "object"
                  }
                },
                "required": [
                  "device",
                  "application",
                  "state"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "host",
            "drafts"
          ],
          "additionalProperties": false
        },
        "routing": {
          "type": "object"
        },
        "security": {
          "type": "object"
        },
        "conditions": {
          "type": "object"
        },
        "annotation": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "type": "string",
          "maxLength": 4096
        },
        "ttl": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "annotation_draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/annotation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "inspector",
        "desktop",
        "routing",
        "security",
        "conditions",
        "annotation",
        "target",
        "ttl"
      ],
      "additionalProperties": false,
      "description": "Inactive editing buffers. Their typed field shapes, ownership, UTF-8 byte limits and quotas are validated by the editor profile; pending input may be semantically invalid until explicitly applied. No commands are run on restore."
    },
    "annotationStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "text",
            "rectangle"
          ]
        },
        "width": {
          "type": "number",
          "minimum": 24,
          "maximum": 10000
        },
        "height": {
          "type": "number",
          "minimum": 24,
          "maximum": 10000
        },
        "font_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 96
        },
        "font": {
          "enum": [
            "proportional",
            "monospace"
          ]
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "border_width": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "text_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "fill_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "border_color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "bold": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "font_size",
        "font",
        "italic",
        "underline",
        "border_width",
        "text_color",
        "fill_color",
        "border_color"
      ]
    }
  }
}
