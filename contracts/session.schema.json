              "$ref": "#/$defs/p2p_config"
            }
          },
          "required": [
            "service",
            "settings"
          ],
          "additionalProperties": false
        }
      ]
    },
    "static_route": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "format": "ipv4"
        },
        "prefix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "gateway": {
          "anyOf": [
            {
              "type": "string",
              "format": "ipv4"
            },
