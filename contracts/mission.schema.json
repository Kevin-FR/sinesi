{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinesi.dev/contracts/mission.schema.json",
  "title": "Mission évaluable Sinesi (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_version",
    "id",
    "chapter",
    "order",
    "title",
    "brief",
    "project",
    "objectives",
    "hints"
  ],
  "properties": {
    "mission_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "chapter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "brief": {
      "$ref": "#/$defs/text"
    },
    "project": {
      "type": "object",
      "description": "Projet Sinesi complet, validé par le contrat de projet."
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "explain",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,64}$"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "explain": {
            "$ref": "#/$defs/text"
          },
          "check": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "device",
                  "equals"
                ],
                "properties": {
                  "kind": {
                    "const": "gateway"
                  },
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equals": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "device",
                  "equals"
                ],
                "properties": {
                  "kind": {
                    "const": "dns_server"
                  },
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "equals": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "a",
                  "b"
                ],
                "properties": {
                  "kind": {
                    "const": "connected"
                  },
                  "a": {
                    "type": "string",
                    "minLength": 1
                  },
                  "b": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "device",
                  "from"
                ],
                "properties": {
                  "kind": {
                    "const": "echo_reply"
                  },
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "from": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "device",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "dns_resolved"
                  },
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "device",
                  "application"
                ],
                "properties": {
                  "kind": {
                    "const": "service_listening"
                  },
                  "device": {
                    "type": "string",
                    "minLength": 1
                  },
                  "application": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "fr"
      ],
      "additionalProperties": false,
      "properties": {
        "fr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "it": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "de": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
