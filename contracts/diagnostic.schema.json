{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sinesi technical diagnostic snapshot, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnostic_version",
    "discarded",
    "entries"
  ],
  "properties": {
    "diagnostic_version": {
      "const": 1
    },
    "discarded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "event": {
          "enum": [
            "startup",
            "configuration_resolved",
            "configuration_fallback",
            "project_ready",
            "project_load_failed",
            "project_save_failed",
            "import_failed",
            "runtime_file_failed",
            "simulation_failed",
            "preferences_write_failed",
            "export_failed",
            "diagnostic_exported",
            "window_ready",
            "window_failed",
            "report_failed",
            "exit"
          ]
        }
      }
    }
  }
}
