        "payload": {
          "type": "object",
          "maxProperties": 32,
          "properties": {
            "frame": {
              "$ref": "#/$defs/frame"
            },
            "packet": {
              "$ref": "#/$defs/packet"
            },
            "kind": {
              "$ref": "#/$defs/notice_kind"
            }
          }
        }
      },
      "required": [
        "event_schema_version",
        "run_id",
        "event_id",
        "time_us",
        "sequence",
        "type",
        "device_id",
        "caused_by",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false
    },
