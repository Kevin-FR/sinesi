            "tcp.state",
            "tcp.retransmit",
            "tcp.segment.sent",
            "tcp.segment.duplicate_or_gap",
            "udp.datagram.sent",
            "ethernet.sent",
            "ethernet.received",
            "ethernet.dropped",
            "ipv4.delivered",
            "ipv4.dropped",
            "tcp.segment.received",
            "udp.datagram.received",
            "udp.datagram.dropped"
