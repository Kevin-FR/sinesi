      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "properties": {
        "syn": {
          "type": "boolean"
        },
        "ack": {
          "type": "boolean"
        },
        "fin": {
          "type": "boolean"
        },
        "rst": {
          "type": "boolean"
        }
      },
      "required": [
        "syn",
        "ack",
        "fin",
        "rst"
      ],
      "additionalProperties": false
    },
    "packet": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "tcp"
            },
            "source_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "destination_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "acknowledgment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "flags": {
              "$ref": "#/$defs/flags"
            },
            "window": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "data_base64": {
              "type": "string",
              "maxLength": 684,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "protocol",
            "source_port",
            "destination_port",
            "sequence",
            "acknowledgment",
            "flags",
            "window",
            "data_base64"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "protocol": {
              "const": "udp"
            },
            "source_port": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "destination_port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "length": {
              "type": "integer",
              "minimum": 8,
              "maximum": 65515
            },
            "data_base64": {
              "type": "string",
              "maxLength": 87344,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "protocol",
            "source_port",
            "destination_port",
            "length",
            "data_base64"
          ],
          "additionalProperties": false
