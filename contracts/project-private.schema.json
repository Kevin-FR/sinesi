{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinesi.dev/contracts/project-private.schema.json",
  "title": "Sinesi private network project J5",
  "$ref": "#/$defs/project",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$"
    },
    "map": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "default_gateway": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "ipv4"
            }
          ]
        },
        "dns_server": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "ipv4"
            }
          ]
        },
        "forwarding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "rip": {
          "type": "boolean"
        },
        "routes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/static_route"
          }
        },
        "dhcp_server": {
          "anyOf": [
            {
              "$ref": "#/$defs/dhcp_config"
            },
            {
              "type": "null"
            }
          ]
        },
        "gateway": {
          "anyOf": [
            {
              "$ref": "#/$defs/gateway"
            },
            {
              "type": "null"
            }
          ]
        },
        "firewall": {
          "anyOf": [
            {
              "$ref": "#/$defs/firewall"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "default_gateway",
        "dns_server"
      ],
      "additionalProperties": false
    },
    "ipv4": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "static"
            },
            "address": {
              "type": "string",
              "format": "ipv4"
            },
            "prefix_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [
            "mode",
            "address",
            "prefix_length"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "dhcp"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "interface": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"
        },
        "medium": {
          "enum": [
            "ethernet",
            "wireless"
          ]
        },
        "ipv4": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ipv4"
            }
          ]
        }
      },
      "required": [
        "id",
        "mac",
        "medium",
        "ipv4"
      ],
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "maxLength": 4096
        },
        "config": {
          "$ref": "#/$defs/map"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/service_config"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "config"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "media_type": {
          "type": "string",
          "maxLength": 4096
        },
        "data_base64": {
          "type": "string",
          "maxLength": 2097152
        }
      },
      "required": [
        "path",
        "media_type",
        "data_base64"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/id"
        },
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "device_id",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "required": [
        "id",
        "text",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "media_type": {
          "type": "string",
          "maxLength": 4096
        },
        "data_base64": {
          "type": "string",
          "maxLength": 2097152
        }
      },
      "required": [
        "id",
        "media_type",
        "data_base64"
      ],
      "additionalProperties": false
    },
    "extension": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "api_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "resource_id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "const": false
        }
      },
      "required": [
        "id",
        "api_version",
        "resource_id",
        "enabled"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "latency_us": {
          "$ref": "#/$defs/decimal"
        },
        "jitter_us": {
          "$ref": "#/$defs/decimal"
        }
      },
      "required": [
        "id",
        "endpoints",
        "latency_us",
        "jitter_us"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "workstation",
            "notebook",
            "switch",
            "router",
            "gateway",
            "modem"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface"
          },
          "maxItems": 128
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "applications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/app"
          },
          "maxItems": 1024
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "interfaces",
        "network",
        "applications",
        "files"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "router"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "interfaces": {
                "minItems": 2,
                "maxItems": 32
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 6
        },
        "semantic_profile": {
          "const": "sns-educational-private-v1"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          },
          "maxItems": 1024
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "maxItems": 4096
        },
        "layout": {
          "type": "object",
          "properties": {
            "devices": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              },
              "maxItems": 1024
            }
          },
          "required": [
            "devices"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          },
          "maxItems": 4096
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "maxItems": 4096
        },
        "extensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extension"
          },
          "maxItems": 128
        },
        "lan": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "maxProperties": 1024,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "display": {
                "enum": [
                  "name",
                  "ipv4",
                  "mac"
                ]
              },
              "sat_retention_us": {
                "$ref": "#/$defs/decimal"
              },
              "symbol": {
                "anyOf": [
                  {
                    "enum": [
                      "desktop",
                      "laptop",
                      "server",
                      "printer",
                      "tablet",
                      "router",
                      "switch"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "display",
              "sat_retention_us"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "semantic_profile",
        "project_id",
        "name",
        "devices",
        "links",
        "layout",
        "annotations",
        "resources",
        "extensions"
      ],
      "additionalProperties": false
    },
    "message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "signal"
            },
            "text": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "http_request"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "path": {
              "type": "string",
              "maxLength": 4096
            },
            "fields": {
              "$ref": "#/$defs/map"
            }
          },
          "required": [
            "kind",
            "method",
            "path",
            "fields"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "http_response"
            },
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "media_type": {
              "type": "string",
              "maxLength": 4096
            },
            "body_base64": {
              "type": "string",
              "maxLength": 2097152
            }
          },
          "required": [
            "kind",
            "status",
            "media_type",
            "body_base64"
          ],
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "properties": {
        "at_us": {
          "$ref": "#/$defs/decimal"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      },
      "required": [
        "at_us",
        "source",
        "target",
        "message"
      ],
      "additionalProperties": false
    },
    "server": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/id"
        },
        "get_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 4096
              },
              "media_type": {
                "type": "string",
                "maxLength": 4096
              },
              "body_base64": {
                "type": "string",
                "maxLength": 2097152
              }
            },
            "required": [
              "path",
              "media_type",
              "body_base64"
            ],
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "post_echo_path": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "device_id",
        "get_routes",
        "post_echo_path"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "scenario_schema_version": {
          "const": 1
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "seed": {
          "$ref": "#/$defs/decimal"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 32768
        },
        "prototype_servers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/server"
          },
          "maxItems": 1024
        }
      },
      "required": [
        "scenario_schema_version",
        "project",
        "seed",
        "actions",
        "prototype_servers"
      ],
      "additionalProperties": false
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "simulation.pause"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "simulation.resume"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "simulation.step"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "simulation.stop"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "prototype.send"
            },
            "payload": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/id"
                },
                "target": {
                  "$ref": "#/$defs/id"
                },
                "message": {
                  "$ref": "#/$defs/message"
                }
              },
              "required": [
                "source",
                "target",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "icmp.ping"
            },
            "payload": {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/id"
                },
                "destination": {
                  "type": "string",
                  "format": "ipv4"
                },
                "ttl": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "source",
                "destination",
                "ttl"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "simulation.manual_loss"
            },
            "payload": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "arp.clear"
            },
            "payload": {
              "type": "object",
              "properties": {
                "device": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "device"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "switch.sat.clear"
            },
            "payload": {
              "type": "object",
              "properties": {
                "device": {
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "device"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ],
          "additionalProperties": false
        }
      ]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "api_version": {
          "const": 1
        },
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "project_id": {
          "$ref": "#/$defs/id"
        },
        "expected_revision": {
          "$ref": "#/$defs/decimal"
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      },
      "required": [
        "api_version",
        "command_id",
        "project_id",
        "expected_revision",
        "run_id",
        "command"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_schema_version": {
          "const": 2
        },
        "run_id": {
          "$ref": "#/$defs/id"
        },
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "time_us": {
          "$ref": "#/$defs/decimal"
        },
        "sequence": {
          "$ref": "#/$defs/decimal"
        },
        "type": {
          "enum": [
            "icmp.echo.requested",
            "icmp.echo.reply",
            "icmp.echo.received",
            "icmp.error",
            "icmp.error.sent",
            "icmp.timeout",
            "ipv4.local",
            "ipv4.route.selected",
            "ipv4.delivered",
            "ipv4.dropped",
            "ethernet.sent",
            "ethernet.received",
            "ethernet.dropped",
            "ethernet.filtered",
            "switch.sat.learned",
            "switch.sat.expired",
            "switch.sat.cleared",
            "switch.forward",
            "switch.flood",
            "arp.request",
            "arp.reply",
            "arp.cache.hit",
            "arp.cache.learned",
            "arp.cache.expired",
            "arp.cache.cleared"
          ]
        },
        "device_id": {
          "$ref": "#/$defs/id"
        },
        "caused_by": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/id"
            }
          ]
        },
        "correlation_id": {
          "$ref": "#/$defs/id"
        },
        "payload": {
          "type": "object",
          "maxProperties": 32,
          "properties": {
            "frame": {
              "$ref": "#/$defs/frame"
            }
          }
        }
      },
      "required": [
        "event_schema_version",
        "run_id",
        "event_id",
        "time_us",
        "sequence",
        "type",
        "device_id",
        "caused_by",
        "correlation_id",
        "payload"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
        },
        "message_key": {
          "type": "string",
          "maxLength": 4096
        },
        "target": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 4096
            }
          ]
        },
        "details": {
          "$ref": "#/$defs/map"
        }
      },
      "required": [
        "code",
        "message_key",
        "target",
        "details"
      ],
      "additionalProperties": false
    },
    "icmp": {
      "type": "object",
      "properties": {
        "message_type": {
          "enum": [
            0,
            3,
            8,
            11
          ]
        },
        "code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
